// Service accounts.
local internal_service_accounts = import 'internal_service_accounts.json';
local external_service_accounts = import 'external_service_accounts.json';

{
  "service_accounts": internal_service_accounts.service_accounts + external_service_accounts.service_accounts,
  "roles": [
    {
      "id": "ai:chat",
      "permissions": [
        "/malonaz.ai.ai_service.v1.AiService/CreateChat",
        "/malonaz.ai.ai_service.v1.AiService/UpdateChat",
        "/malonaz.ai.ai_service.v1.AiService/DeleteChat",
        "/malonaz.ai.ai_service.v1.AiService/ListChats",
        "/malonaz.ai.ai_service.v1.AiService/GetChat"
      ],
    },

    {
      "id": "ai:message",
      "permissions": [
        "/malonaz.ai.ai_service.v1.AiService/CreateMessage",
        "/malonaz.ai.ai_service.v1.AiService/UpdateMessage",
        "/malonaz.ai.ai_service.v1.AiService/DeleteMessage",
        "/malonaz.ai.ai_service.v1.AiService/ListMessages",
        "/malonaz.ai.ai_service.v1.AiService/GetMessage",
        "/malonaz.ai.ai_service.v1.AiService/GenerateMessage",
        "/malonaz.ai.ai_service.v1.AiService/StreamGenerateMessage",
      ],
    },

    {
      "id": "ai:speech_to_text",
      "permissions": [
        "/malonaz.ai.ai_service.v1.AiService/SpeechToText",
        "/malonaz.ai.ai_service.v1.AiService/SpeechToTextStream"
      ]
    },

    {
      "id": "ai:text_to_text",
      "permissions": [
        "/malonaz.ai.ai_service.v1.AiService/TextToText",
        "/malonaz.ai.ai_service.v1.AiService/TextToTextStream",
      ],
    },

    {
      "id": "ai:model:reader",
      "permissions": [
        "/malonaz.ai.ai_service.v1.AiService/ListModels",
      ],
    },
  ],
}

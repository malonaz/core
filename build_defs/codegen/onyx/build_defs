def onyx_k8s(
        name:str,
        manifest:str,
        image:str="",
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The Kubernetes base of a MainManifest, written next to it: serviceaccount.yaml,
    deployment.yaml, service.yaml, networkpolicy.yaml, pdb.yaml, ingress.yaml when a server is public,
    and the kustomization.yaml listing them.

    Args:
      image: docker_image rule the Deployment runs. Defaults to the binary's name, for an overlay to set.
    """
    cmd = f"mkdir _k8s && $TOOLS --mode k8s --manifest $(location {manifest}) --output _k8s"
    deps = [manifest]
    if image:
        fqn = canonicalise(image) + "_fqn"
        cmd += f' --image "$(cat $(location {fqn}))"'
        deps += [fqn]
    return genrule(
        name = name,
        output_dirs = ["_k8s"],
        cmd = cmd,
        deps = deps,
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "k8s"],
        visibility = visibility,
        test_only = test_only,
    )


def onyx_k8s_external(
        name:str,
        manifest:str="external.yaml",
        image:str="",
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The Kubernetes base of an ExternalManifest, for a binary onyx does not generate (e.g. Python):
    the same files as onyx_k8s, with the pod probed over grpc.health.v1.

    Args:
      manifest: The ExternalManifest yaml.
      image: docker_image rule the Deployment runs. Defaults to the binary's name, for an overlay to set.
    """
    cmd = "mkdir _k8s && $TOOLS --mode k8s-external --manifest $SRCS --output _k8s"
    deps = []
    if image:
        fqn = canonicalise(image) + "_fqn"
        cmd += f' --image "$(cat $(location {fqn}))"'
        deps += [fqn]
    return genrule(
        name = name,
        srcs = [manifest],
        output_dirs = ["_k8s"],
        cmd = cmd,
        deps = deps,
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "k8s"],
        visibility = visibility,
        test_only = test_only,
    )


def onyx_deployment(
        name:str,
        manifest:str="manifest.yaml",
        manifest_deps:list=[],
        base_image:str="",
        image:str="",
        repo:str="",
        local_args:list=None,
        labels:list=[],
        visibility:list=[],
        test_only:bool=False,
):
    """What deploys the onyx binary `:<name>` of the package, besides its main.go and go_binary
    (which stay in the BUILD file, for wollemi to manage):

      :manifest  onyx_manifest of `manifest`, which onyx_main_src reads
      :k8s       onyx_k8s
      :image     with `base_image`: crane_image of the binary in /app, run as uid 10001
      :local     with `local_args`: sh_cmd running the binary with them

    Args:
      name: The binary's go_binary in this package.
      manifest: The MainManifest yaml.
      manifest_deps: Labels the manifest names, as onyx_manifest's deps.
      base_image: Image the binary is appended to: a docker_image target or a reference.
      image: Name of the image. Defaults to the binary's.
      repo: Registry prefix of the image.
      local_args: Flags of `plz run :local`, running the binary on a laptop.
      labels: Labels of :k8s and :image.
      visibility: Visibility of :k8s and :image.
      test_only: Whether the binary is test only.
    """
    onyx_manifest(
        name = "manifest",
        manifest = manifest,
        deps = manifest_deps,
        test_only = test_only,
    )
    onyx_k8s(
        name = "k8s",
        manifest = ":manifest",
        labels = labels,
        visibility = visibility,
        test_only = test_only,
    )
    binary = "//" + package_name() + ":" + name
    if base_image:
        layer = crane_layer(
            name = tag("image", "layer"),
            srcs = [binary],
            dir = "/app",
        )
        # uid 10001 is the user onyx_k8s's Deployment runs as.
        crane_image(
            name = "image",
            base_image = base_image,
            layers = [layer],
            image = image or name,
            repo = repo,
            cmd = ["./" + name],
            workdir = "/app",
            user = "10001",
            labels = labels,
            visibility = visibility,
        )
    if local_args != None:
        sh_cmd(
            name = "local",
            cmd = " ".join([f"plz run {binary} --"] + local_args),
        )


def _onyx_src(name:str, mode:str, manifest:str, visibility:list, labels:list, test_only:bool):
    cmd = f"$TOOLS --mode {mode} --manifest $(location {manifest}) --output $OUT"
    if CONFIG.GO.IMPORT_PATH:
        cmd += f" --go-import-path {CONFIG.GO.IMPORT_PATH}"
    return genrule(
        name = name,
        outs = [name],
        cmd = cmd,
        deps = [manifest],
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "go"],
        visibility = visibility,
        test_only = test_only,
    )

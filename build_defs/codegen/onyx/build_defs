def onyx_manifest(
        name:str,
        manifest:str="manifest.yaml",
        deps:list=[],
        visibility:list=[],
        test_only:bool=False,
):
    """An onyx manifest, its labels resolved to the files they build.

    Every label in `deps` that the manifest names is rewritten to `//label(files...)`, which onyx
    reads back to find the manifests, protos and packages the label produces.
    """
    cmd = ["cp $SRCS $OUT"]
    for dep in deps:
        canonical_dep = canonicalise(dep)
        cmd.append(f"sed -i 's|{dep}$|{canonical_dep}($(locations {dep}))|' $OUT")
    return genrule(
        name = name,
        srcs = [manifest],
        outs = [name],
        cmd = cmd,
        deps = deps,
        exported_deps = deps,
        visibility = visibility,
        test_only = test_only,
    )


def onyx_service_src(
        name:str,
        manifest:str,
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The Service file of a ServiceManifest."""
    return _onyx_src(name, "service", manifest, visibility, labels, test_only)


def onyx_main_src(
        name:str,
        manifest:str,
        deployment:bool=False,
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The main file of a MainManifest.

    Args:
      deployment: `manifest` is a ServiceManifest's onyx_manifest: generate its deployment.
    """
    return _onyx_src(name, "main", manifest, visibility, labels, test_only, deployment)


def onyx_k8s(
        name:str,
        manifest:str,
        deployment:bool=False,
        image:str="",
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The Kubernetes base of a MainManifest, written next to it: serviceaccount.yaml,
    deployment.yaml, service.yaml, networkpolicy.yaml, pdb.yaml, ingress.yaml when a server is public,
    and the kustomization.yaml listing them.

    Args:
      deployment: `manifest` is a ServiceManifest's onyx_manifest: generate its deployment.
      image: docker_image rule the Deployment runs. Defaults to the binary's name, for an overlay to set.
    """
    cmd = f"mkdir _k8s && $TOOLS --mode k8s --manifest $(location {manifest}) --output _k8s"
    if deployment:
        cmd += " --service-label " + canonicalise(manifest)
    deps = [manifest]
    if image:
        fqn = canonicalise(image) + "_fqn"
        cmd += f' --image "$(cat $(location {fqn}))"'
        deps += [fqn]
    return genrule(
        name = name,
        output_dirs = ["_k8s"],
        cmd = cmd,
        deps = deps,
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "k8s"],
        visibility = visibility,
        test_only = test_only,
    )


def onyx_k8s_external(
        name:str,
        manifest:str="external.yaml",
        image:str="",
        visibility:list=[],
        labels:list=[],
        test_only:bool=False,
):
    """The Kubernetes base of an ExternalManifest, for a binary onyx does not generate (e.g. Python):
    the same files as onyx_k8s, with the pod probed over grpc.health.v1.

    Args:
      manifest: The ExternalManifest yaml.
      image: docker_image rule the Deployment runs. Defaults to the binary's name, for an overlay to set.
    """
    cmd = "mkdir _k8s && $TOOLS --mode k8s-external --manifest $SRCS --output _k8s"
    deps = []
    if image:
        fqn = canonicalise(image) + "_fqn"
        cmd += f' --image "$(cat $(location {fqn}))"'
        deps += [fqn]
    return genrule(
        name = name,
        srcs = [manifest],
        output_dirs = ["_k8s"],
        cmd = cmd,
        deps = deps,
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "k8s"],
        visibility = visibility,
        test_only = test_only,
    )


def onyx_deployment(
        name:str,
        service:str=":manifest",
        manifest:str="",
        manifest_deps:list=[],
        base_image:str="",
        image:str="",
        repo:str="",
        local_args:list=[],
        labels:list=[],
        visibility:list=[],
        test_only:bool=False,
):
    """The generated main and what deploys the onyx binary `:<name>`, whose go_binary stays in the
    BUILD file for wollemi to manage, with `:<name>_main.go` in its srcs (.wollemi.json's
    `codegen_macro_formatting` maps onyx_deployment to that file). By default the binary runs one
    service: the `deployment` of the package's `:manifest`. A binary composing several services
    sets `manifest` to its own MainManifest instead.

      :<name>_manifest  onyx_manifest of `manifest`, when set
      :<name>_main.go   onyx_main_src
      :<name>_k8s       onyx_k8s
      :<name>_image     crane_image of the binary in /app, run as uid 10001
      :<name>_local     sh_cmd running the binary for a laptop

    The image and local run are left out of a test only binary.

    Args:
      name: The binary's go_binary in this package.
      service: onyx_manifest of the ServiceManifest whose deployment the binary is.
      manifest: A MainManifest yaml, in place of `service`.
      manifest_deps: Labels `manifest` names, as onyx_manifest's deps.
      base_image: Image the binary is appended to. Defaults to the core plugin's OnyxBaseImage.
      image: Name of the image. Defaults to OnyxImage, else the binary's.
      repo: Registry prefix of the image. Defaults to OnyxRepo.
      local_args: Flags of :<name>_local, after OnyxLocalArgs.
      labels: Labels of :<name>_k8s and :<name>_image.
      visibility: Visibility of :<name>_k8s and :<name>_image.
      test_only: Whether the binary is test only.
    """
    manifest_rule = service
    if manifest:
        manifest_rule = onyx_manifest(
            name = name + "_manifest",
            manifest = manifest,
            deps = manifest_deps,
            test_only = test_only,
        )
    onyx_main_src(
        name = name + "_main.go",
        manifest = manifest_rule,
        deployment = not manifest,
        test_only = test_only,
    )
    onyx_k8s(
        name = name + "_k8s",
        manifest = manifest_rule,
        deployment = not manifest,
        labels = labels,
        visibility = visibility,
        test_only = test_only,
    )
    if test_only:
        return
    binary = "//" + package_name() + ":" + name
    layer = crane_layer(
        name = tag(name, "layer"),
        srcs = [binary],
        dir = "/app",
    )
    # uid 10001 is the user onyx_k8s's Deployment runs as.
    crane_image(
        name = name + "_image",
        base_image = base_image or CONFIG.CORE.ONYX_BASE_IMAGE,
        layers = [layer],
        image = image or CONFIG.CORE.ONYX_IMAGE or name,
        repo = repo or CONFIG.CORE.ONYX_REPO,
        cmd = ["./" + name],
        workdir = "/app",
        user = "10001",
        labels = labels,
        visibility = visibility,
    )
    sh_cmd(
        name = name + "_local",
        cmd = " ".join(["plz run " + binary + " --"] + CONFIG.CORE.ONYX_LOCAL_ARGS + local_args),
    )


def _onyx_src(name:str, mode:str, manifest:str, visibility:list, labels:list, test_only:bool, deployment:bool=False):
    cmd = f"$TOOLS --mode {mode} --manifest $(location {manifest}) --output $OUT"
    if deployment:
        cmd += " --service-label " + canonicalise(manifest)
    if CONFIG.GO.IMPORT_PATH:
        cmd += f" --go-import-path {CONFIG.GO.IMPORT_PATH}"
    return genrule(
        name = name,
        outs = [name],
        cmd = cmd,
        deps = [manifest],
        tools = [CONFIG.CORE.ONYX],
        labels = labels + ["codegen", "go"],
        visibility = visibility,
        test_only = test_only,
    )

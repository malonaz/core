subinclude("//build_defs/codegen/go_service:build_defs")
subinclude("///go//build_defs:go")
subinclude("//build_defs:utils")

def postgres_migrations(
        name:str,
        dirs:list,
        visibility:list=[],
):
    # Generate a yaml file containing the ordered list of migration dirs.
    manifest_yaml = "\n".join([f"- {d}" for d in dirs])
    genrule(
        name = "_manifest",
        outs = ["manifest.yaml"],
        cmd = f"echo 'dirs:\n{manifest_yaml}' > $OUTS",
    )

    srcs = [":_manifest"]
    for dir in dirs:
        srcs += glob(f"{dir}/*.sql")
        srcs += [f"{dir}/manifest.yaml"]

    filegroup(
        name = name,
        srcs = srcs,
        visibility = visibility,
    )

    # Test
    go_template(
        name = "migration_hash_test.go",
        test_only = True,
        extra_data = {
            "dirs": ','.join([package_name() + "/" + d for d in dirs]),
        },
        templates = [plugin_target("//build_defs/codegen/postgres/templates:migrations_test.go.tmpl")]
    )

    go_test(
        name = "migration_hash_test",
        srcs = [":migration_hash_test.go"],
        data = dirs,
        deps = [
            plugin_go_lib("//go/postgres/migrator/migrations"),
            "//third_party/go:github.com__stretchr__testify__require",
        ],
        visibility=visibility,
    )

    # System acceptance test: run the migrations against a real postgres instance.
    # The migrator and the postgres distribution are copied into this package so their paths
    # are the same whether these build defs are used from core itself or from a repo consuming
    # core as a plugin, where they resolve to the ///core subrepo instead.
    genrule(
        name = "_postgres_migrator",
        srcs = [plugin_target("//cmd/postgres-migrator")],
        outs = ["postgres-migrator"],
        cmd = "mv $SRCS $OUT",
        binary = True,
        test_only = True,
    )

    genrule(
        name = "_postgres_distribution",
        srcs = [plugin_target("//third_party/binary/postgres:postgres")],
        outs = ["postgres_distribution"],
        cmd = "mv $SRCS $OUT",
        test_only = True,
    )

    go_template(
        name = "migration_sat_test.go",
        test_only = True,
        extra_data = {
            "dirs": ','.join([package_name() + "/" + d for d in dirs]),
            "root_dir": package_name(),
            "migrator_path": package_name() + "/postgres-migrator",
            "postgres_binary_dir": package_name() + "/postgres_distribution/bin",
        },
        templates = [plugin_target("//build_defs/codegen/postgres/templates:migrations_sat_test.go.tmpl")]
    )

    go_test(
        name = "migration_sat_test",
        srcs = [":migration_sat_test.go"],
        data = [":" + name, ":_postgres_migrator", ":_postgres_distribution"],
        test_outputs = ["sat.log"],
        deps = [
            plugin_go_lib("//go/postgres"),
            plugin_go_lib("//go/postgres/migrator/migrations"),
            plugin_go_lib("//go/sat"),
            "//third_party/go:github.com__stretchr__testify__require",
        ],
        visibility=visibility,
    )

package main

// migrationsRootDirectory holds the manifest.yaml declaring the total order of
// every migration in this database.
const migrationsRootDirectory = "{{ .extra.root_dir }}"

func TestMigrations(t *{{ goImport "testing" }}.T) {
	migrations, err := {{ goImport "github.com/malonaz/core/go/postgres/migrator/migrations" }}.GetMigrations({{ goImport "os" }}.ReadFile, migrationsRootDirectory)
	{{ goImport "github.com/stretchr/testify/require" }}.NoError(t, err)
	require.NotEmpty(t, migrations, "no migrations declared")
	for _, migration := range migrations {
		require.Equal(t, migration.ExpectedHash, migration.Hash, "Hash migration has changed.")
	}
}

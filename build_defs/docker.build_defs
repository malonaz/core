subinclude("///shell//build_defs:shell")

def docker_image(
        name,
        srcs = [],
        version = "",
        dockerfile = "Dockerfile",
        base_image = "",
        image = "",
        labels = [],
        run_args = "",
        repo = "",
        test_only = False,
        visibility = None):
    """docker_image defines a build rule for a Docker image.

    You must use `plz run` to actually build the target.
    There are also several related targets created, for example a fully qualified name
    (henceforth fqn) which is used by other rules to identify this one.

    Args:
      name: Name of the rule.
      srcs: Source files that are available within the dockerfile.
      image: Name of the image to create. Defaults to '<package_name>/<name>'.
      version: Version to tag the image with. If not given, a hash will be derived for the version.
      dockerfile: The Dockerfile that defines how to build this image.
      base_image: The build target that defines the base image. Only necessary if this image
                  is based off another plz image.
      labels: Labels to tag this rule with.
      run_args: Any additional arguments to provide to 'docker run'.
      repo: Registry/repository prefix for the fqn (e.g. an ECR registry URL).
      test_only: If True, this can only be depended on by test rules.
      visibility: Visibility of this rule.
    """
    image = image or package_name() + "/" + name
    if base_image:
        base_image = canonicalise(base_image)
    labels += ["docker_image=" + image, "docker"]

    # This tarball becomes the build context for Docker.
    tarball, dockerfile = _docker_tarball_rule(
        name = name,
        srcs = srcs,
        dockerfile = dockerfile,
        base_image = base_image,
        test_only = test_only,
    )

    # The FQN defines a unique hash for the image.
    version = version or '$(echo $(hash %s) | md5sum - | cut -f1 -d" ")' % tarball
    fqn = build_rule(
        name = "%s_fqn" % name,
        srcs = [tarball],
        cmd = 'echo -n "%s/%s:%s" >> $OUT' % (repo, image, version),
        outs = ["%s_fqn" % name],
        deps = ["%s_fqn" % base_image if base_image else None],
        labels = labels,
        stamp = True,
        visibility = visibility,
        test_only = test_only,
    )

    # docker build
    cmd = "docker build -t `cat $SRCS_FQN` -f $(basename $SRCS_DOCKERFILE) - < $(out_location %s)" % tarball
    if base_image:
        cmd = "./$(out_location %s) && %s" % (base_image, cmd)
    docker_build = sh_cmd(
        name = name,
        cmd = cmd,
        srcs = {
            "fqn": [fqn],
            "dockerfile": [dockerfile],
        },
        # data, not deps: a remote `plz run` downloads only a script's data.
        data = [base_image, tarball] if base_image else [tarball],
        visibility = visibility,
        labels = labels + ["docker-build"],
    )

    # For compat reasons _load is an alias for the main build target.
    filegroup(
        name = name + "_load",
        srcs = [docker_build],
        binary = True,
        test_only = test_only,
    )

    # docker run
    sh_cmd(
        name = name + "_run",
        cmd = "./$(out_location %s) && docker run -it %s `cat $SRCS`" % (docker_build, run_args),
        srcs = [fqn],
        data = [docker_build],
        visibility = visibility,
        labels = labels,
    )

    # docker push
    sh_cmd(
        name = name + "_push",
        cmd = [
            "./$(out_location %s) && docker push `cat $SRCS`;" % docker_build,
        ],
        srcs = [fqn],
        data = [docker_build],
        visibility = visibility,
        labels = labels,
    )
    return docker_build

def _docker_tarball_rule(name, srcs, dockerfile, base_image, test_only):
    """Defines the tarball rule containing all required data for generating the container.

    The resulting tarball will contain the Dockerfile as well as any required artifacts.
    This will then later on be fed into `docker build` as a docker context.
    """
    if base_image:
        # Define rule to template the source image into the Dockerfile.
        if dockerfile.startswith("//"):
            _, _, label = dockerfile.partition(":")
            out = "Dockerfile-" + label
        else:
            out = dockerfile

        sanitized_base_image = "//" + base_image.split("//")[-1]

        dockerfile = build_rule(
            name = name,
            tag = "dockerfile",
            srcs = {
                "dockerfile": [dockerfile],
                "fqn": [base_image + "_fqn"],
            },
            outs = [out],
            cmd = 'FQN="`cat $SRCS_FQN`"; sed -e "s|%s|$FQN|g" $SRCS_DOCKERFILE >> $OUTS' % sanitized_base_image,
            test_only = test_only,
        )

    return tarball(
        name = "_%s#docker_context" % name,
        srcs = srcs + [dockerfile],
        test_only = test_only,
    ), dockerfile

# Packs srcs under a directory as root-owned, timestamp-free entries, so a layer's digest only
# changes with its content.
_CRANE_LAYER_PY = """
import gzip, os, sys, tarfile
def root(info):
    info.uid = info.gid = 0
    info.uname = info.gname = "root"
    info.mtime = 0
    return info
with gzip.GzipFile(os.environ["OUT"], "wb", compresslevel=6, mtime=0) as gz:
    with tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as tar:
        for src in sys.argv[2:]:
            tar.add(src, arcname=os.path.join(sys.argv[1], os.path.basename(src)), filter=root)
"""

def crane_layer(name, srcs, dir = "/", labels = [], visibility = None):
    """crane_layer defines an image layer for crane_image, owned by root like a Dockerfile COPY.

    Args:
      name: Name of the rule.
      srcs: Files or directories, placed under dir by their base name.
      dir: Directory in the image to place srcs in.
      labels: Labels to tag this rule with, e.g. manual for a layer only deploys build.
      visibility: Visibility of this rule.
    """
    return build_rule(
        name = name,
        srcs = srcs,
        outs = [name + ".tar.gz"],
        cmd = "python3 -c '%s' %s $SRCS" % (_CRANE_LAYER_PY, _shell_quote(dir.lstrip("/"))),
        labels = labels,
        visibility = visibility,
    )

def crane_image(
        name,
        base_image,
        layers,
        image = "",
        repo = "",
        cmd = [],
        entrypoint = [],
        workdir = "",
        user = "",
        env = {},
        exposed_ports = [],
        labels = [],
        visibility = None):
    """crane_image defines an image made by appending layer tarballs to a base image with crane.

    There is no Docker build: crane assembles the image in the registry and uploads only the
    layers it lacks, so a large layer that rarely changes costs nothing on a push.

    Use `plz run :<name>_push` to push it, or `plz run :<name>` to load it into Docker. Both need
    registry access, since crane reads the base image from the registry.

    Args:
      name: Name of the rule.
      base_image: A docker_image target, pushed before appending, or an image reference.
      layers: crane_layer targets, appended in order.
      image: Name of the image to create. Defaults to '<package_name>/<name>'.
      repo: Registry/repository prefix for the fqn (e.g. an ECR registry URL).
      cmd: Exec-form CMD. crane splits values on commas, so arguments can't contain one.
      entrypoint: Exec-form ENTRYPOINT, same comma caveat as cmd.
      workdir: Working directory.
      user: User to run as.
      env: Environment variables to set.
      exposed_ports: Ports to expose, e.g. "8080" or "8080/tcp".
      labels: Labels to tag this rule with.
      visibility: Visibility of this rule.
    """
    image = image or package_name() + "/" + name
    labels += ["docker_image=" + image, "docker"]
    base_is_target = base_image.startswith("//") or base_image.startswith(":")
    if base_is_target:
        base_image = canonicalise(base_image)

    mutate_args = []
    for arg in entrypoint:
        mutate_args += ["--entrypoint=" + _shell_quote(arg)]
    for arg in cmd:
        mutate_args += ["--cmd=" + _shell_quote(arg)]
    if workdir:
        mutate_args += ["--workdir=" + _shell_quote(workdir)]
    if user:
        mutate_args += ["--user=" + _shell_quote(user)]
    for key, value in sorted(env.items()):
        mutate_args += ["--env=" + _shell_quote(key + "=" + value)]
    for port in exposed_ports:
        mutate_args += ["--exposed-ports=" + _shell_quote(port)]
    mutate_args += ["--append=$(out_location %s)" % layer for layer in layers]
    mutate_args = " ".join(mutate_args)

    # The version hashes the base, every layer and the image config.
    hashes = " ".join(["$(hash %s)" % src for src in layers + ([base_image + "_fqn"] if base_is_target else [])])
    version = "$(echo %s %s %s | md5sum - | cut -f1 -d' ')" % (hashes, _shell_quote(base_image), _shell_quote(mutate_args))
    fqn = build_rule(
        name = "%s_fqn" % name,
        srcs = layers,
        cmd = 'echo -n "%s/%s:%s" >> $OUT' % (repo, image, version),
        outs = ["%s_fqn" % name],
        deps = [base_image + "_fqn"] if base_is_target else [],
        labels = labels,
        stamp = True,
        visibility = visibility,
    )

    base_ref = "`cat $SRCS_BASE`" if base_is_target else base_image
    mutate = "$(out_location %s) mutate %s %s --tag `cat $SRCS_FQN`" % (CONFIG.CORE.CRANE, base_ref, mutate_args)
    srcs = {"fqn": [fqn]}
    if base_is_target:
        srcs["base"] = [base_image + "_fqn"]
    # data, not deps: a remote `plz run` downloads only a script's data.
    data = [CONFIG.CORE.CRANE] + layers + ([base_image + "_push"] if base_is_target else [])
    push_base = ["./$(out_location %s_push)" % base_image] if base_is_target else []

    # crane mutate pushes the result.
    crane_push = sh_cmd(
        name = name + "_push",
        cmd = push_base + [mutate],
        srcs = srcs,
        data = data,
        visibility = visibility,
        labels = labels,
    )

    # Writes the image to a tarball instead of pushing it, then loads that into Docker.
    tar = "plz-out/tmp/%s.tar" % name
    crane_load = sh_cmd(
        name = name,
        cmd = push_base + [mutate + " --output " + tar, "docker load -i " + tar, "rm -f " + tar],
        srcs = srcs,
        data = data,
        visibility = visibility,
        labels = labels + ["docker-build"],
    )

    sh_cmd(
        name = name + "_run",
        cmd = "./$(out_location %s) && docker run -it `cat $SRCS`" % crane_load,
        srcs = [fqn],
        data = [crane_load],
        visibility = visibility,
        labels = labels,
    )
    return crane_load

def _shell_quote(s):
    return "'" + s.replace("'", "'\"'\"'") + "'"

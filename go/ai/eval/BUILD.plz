go_library(
    name = "eval",
    srcs = [
        "eval.go",
        "judge.go",
        "record.go",
        "transcript.go",
    ],
    visibility = ["//..."],
    deps = [
        "//go/ai",
        "//go/aip",
        "//go/grpc/status",
        "//go/pbutil",
        "//go/pbutil/pbfieldmask",

go_library(
    name = "agent_executor",
    srcs = [
        "agent.go",
        "agent_tools.go",
        "executor.go",
        "tool.go",
        "turn.go",
    ],
    visibility = ["//..."],
    deps = [
        "//go/ai",
        "//go/aip",
        "//go/grpc/status",
        "//go/pbutil",
        "//go/pbutil/pbfieldmask",
        "//go/uuid",
        "//malonaz/ai/agent/agent_service/v1",
        "//malonaz/ai/agent/v1",
        "//malonaz/ai/ai_service/v1",
        "//malonaz/ai/v1",
        "//malonaz/json/v1",
        "//third_party/go:golang.org__x__sync__errgroup",
        "//third_party/go:google.golang.org__grpc__codes",
        "//third_party/go:google.golang.org__grpc__status",
        "//third_party/go:google.golang.org__protobuf__proto",
        "//third_party/go:google.golang.org__protobuf__types__known__structpb",
    ],
)


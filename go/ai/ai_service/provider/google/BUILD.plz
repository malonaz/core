go_library(
    name = "google",
    srcs = [
        "decision.go",
        "generate_message.go",
        "google.go",
    ],
    visibility = ["//..."],
    deps = [
        "//go/ai",
        "//go/ai/ai_service/provider",
        "//go/grpc/status",
        "//malonaz/ai/ai_service/v1",
        "//malonaz/ai/v1",
        "//third_party/go:cloud.google.com__go__auth__credentials",
        "//third_party/go:google.golang.org__genai",
        "//third_party/go:google.golang.org__grpc__codes",
        "//third_party/go:google.golang.org__protobuf__types__known__durationpb",
    ],
)

go_test(
    name = "test",
    srcs = [
        "decision_test.go",
        "generate_message_test.go",
    ],
    deps = [
        ":google",
        "//go/ai",
        "//go/ai/ai_service/provider",
        "//go/grpc/require",
        "//malonaz/ai/ai_service/v1",
        "//malonaz/ai/v1",
        "//malonaz/json/v1",
        "//third_party/go:github.com__stretchr__testify__require",
        "//third_party/go:google.golang.org__genai",
    ],
)

go_library(
    name = "openai",
    srcs = [
        "decision.go",
        "generate_message.go",
        "openai.go",
        "speech_to_text.go",
        "text_to_speech.go",
    ],
    visibility = ["//..."],
    deps = [
        "//go/ai",
        "//go/ai/ai_service/provider",
        "//go/audio",
        "//go/grpc/status",
        "//malonaz/ai/ai_service/v1",
        "//malonaz/ai/v1",
        "//malonaz/audio/v1",
        "//third_party/go:github.com__openai__openai-go__v3",
        "//third_party/go:github.com__openai__openai-go__v3__option",
        "//third_party/go:github.com__openai__openai-go__v3__packages__respjson",
        "//third_party/go:github.com__openai__openai-go__v3__shared",
        "//third_party/go:github.com__sashabaranov__go-openai",
        "//third_party/go:google.golang.org__grpc__codes",
        "//third_party/go:google.golang.org__protobuf__types__known__durationpb",
        "//third_party/go:google.golang.org__protobuf__types__known__timestamppb",
    ],
)

go_test(
    name = "test",
    srcs = ["decision_test.go"],
    deps = [
        ":openai",
        "//go/grpc/require",
        "//malonaz/ai/v1",
        "//third_party/go:github.com__stretchr__testify__require",
    ],
)

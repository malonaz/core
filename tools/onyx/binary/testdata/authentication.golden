func handleSignals(ctx context.Context, errChan chan error, gracefulStopFns, stopFns []func() error) {
	signalChan := make(chan os.Signal, 2) // One for each category of stops.
	signal.Notify(signalChan, syscall.SIGTERM, syscall.SIGINT, syscall.SIGHUP)

	slog.InfoContext(ctx, "waiting for signal")
	select {
	case sig := <-signalChan:
		slog.InfoContext(ctx, "received signal #1: initiating graceful shutdown", "signal", sig)
	case err := <-errChan:
		slog.ErrorContext(ctx, "server failed", "error", err)
	}

	// Graceful stops run in reverse start order; a second signal forces the stop.
	gracefulDone := make(chan struct{})
	go func() {
		for i := len(gracefulStopFns) - 1; i >= 0; i-- {
			gracefulStopFns[i]()
		}
		close(gracefulDone)
	}()
	select {
	case <-gracefulDone:
		slog.InfoContext(ctx, "graceful shutdown completed")
	case sig := <-signalChan:
		slog.WarnContext(ctx, "received signal #2: initiating force shutdown", "signal", sig)
		for i := len(stopFns) - 1; i >= 0; i-- {
			stopFns[i]()
		}
		slog.InfoContext(ctx, "force shutdown completed")
	}
}
